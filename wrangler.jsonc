{
  "name": "gb",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  // wrangler deploy (Workers Builds) and wrangler dev run this first: the site into dist/, then the typecheck.
  "build": { "command": "npm run build", "watch_dir": ["src", "worker", "index.html"] },
  // The SPA is served from dist/; only /api/* runs the Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Custom Domain: the zone gb-songs.com must be active in this Cloudflare account; the deploy creates the DNS
  // record and certificate. No workers.dev URL.
  "routes": [{ "pattern": "www.gb-songs.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gb-db",
      "database_id": "4b86277f-935a-4936-8558-6366d355e2b3",
      "migrations_dir": "migrations"
    }
  ],
  // The songs' audio: the uploaded recordings and the tracks the converter makes (worker/util.ts objectKey).
  // The bucket must exist before the first deploy that binds it (README "Deploy").
  "r2_buckets": [{ "binding": "SONGS", "bucket_name": "gb-songs" }],
  "observability": { "enabled": true }
}
